{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [":PACKAGE:", ":BLANK_LINE:", ["~/**"], ":BLANK_LINE:", ["./**"]]
					}
				}
			}
		},
		"enabled": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"linter": {
		"enabled": true,
		"rules": {
			"a11y": {
				"noAmbiguousAnchorText": "off",
				"noSvgWithoutTitle": "off"
			},
			"correctness": {
				"noUnusedImports": "warn",
				"noUnusedFunctionParameters": {
					"fix": "none",
					"level": "warn",
					"options": {}
				},
				"noUnusedVariables": {
					"fix": "none",
					"level": "warn",
					"options": {}
				}
			},
			"style": {
				"noDefaultExport": "off"
			},
			"suspicious": {
				"noConsole": {
					"fix": "none",
					"level": "warn",
					"options": {
						"allow": ["info"]
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	}
}
